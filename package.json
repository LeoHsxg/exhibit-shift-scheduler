    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "15.34.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
